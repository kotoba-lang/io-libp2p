{:paths ["src"]
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/wire {:git/url "https://github.com/kotoba-lang/wire.git"
                                     :git/sha "bda40f1514569fb6557eee6fac04c378da69b1f0"}
        ;; The libp2p connection stack. Each layer was already implemented in
        ;; this workspace as a pure state machine with no socket; what was
        ;; missing was the thing that runs them in order over one.
        io.github.kotoba-lang/io-libp2p-specs-transport
        {:git/url "https://github.com/kotoba-lang/io-libp2p-specs-transport.git"
         :git/sha "b4f904b42fa4eaefb4f397dfe4a805f1f5a99470"}
        io.github.kotoba-lang/io-libp2p-specs-kad-dht
        {:git/url "https://github.com/kotoba-lang/io-libp2p-specs-kad-dht.git"
         :git/sha "7c4de6d971ce7c14adc6d07d3b4e3b1eeac68eae"}
        io.github.kotoba-lang/noise
        {:git/url "https://github.com/kotoba-lang/noise.git"
         :git/sha "8eccaff35e1c6e5dec64fb81a9d62c7618e4b018"}
        io.github.kotoba-lang/dev-protobuf
        {:git/url "https://github.com/kotoba-lang/dev-protobuf.git"
         :git/sha "3f20b1e1cdbe89750d8afaf24f64777a2f170c3c"}
        ;; Ed25519 for the identity key the peer id is derived from. Injected
        ;; into the driver rather than required by it -- the driver holds no
        ;; keys -- but the tests and CLI need a concrete signer.
        ;; The IPNS record validator. Kept in its own namespace so a node that
        ;; validates nothing never loads it -- the store stays
        ;; validator-injected, and this is one concrete validator rather than a
        ;; special case inside the store.
        io.github.kotoba-lang/tech-ipfs-specs-ipns
        {:git/url "https://github.com/kotoba-lang/tech-ipfs-specs-ipns.git"
         :git/sha "274ac7dd41b6f7b08dd02db8cb347f58684ad0c4"}
        io.github.kotoba-lang/org-ietf-ed25519
        {:git/url "https://github.com/kotoba-lang/org-ietf-ed25519.git"
         :git/sha "fdcefb9f1b83461fee54d04b63e374fa301ee847"}
        io.github.kotoba-lang/io-multiformats
        {:git/url "https://github.com/kotoba-lang/io-multiformats.git"
         :git/sha "95bb0da5893be9308c27bb24ebd4c7c64d84ee9c"}}
 :aliases {:test {:extra-paths ["test"]
                  :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                  :main-opts ["-m" "cognitect.test-runner"]}
                ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
                :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
                  :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                              "--fail-level" "error"]}}}
